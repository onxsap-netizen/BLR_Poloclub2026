# Supabase — get these from your Supabase project's Settings > API Keys
#
# Supabase now issues two key formats — both work fine here, use whichever
# your project shows:
#   New format:    sb_publishable_...   /  sb_secret_...
#   Legacy format: anon (eyJ...)        /  service_role (eyJ...)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (new) OR anon key (legacy) — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY. Never expose this to the browser or commit it.
# Secret key (new, sb_secret_...) OR service_role key (legacy)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Note: the /admin dashboard currently has no password — it's open to
# anyone with the URL. No ADMIN_PASSWORD variable is needed.
